{
  "name": "lumina-monorepo",
  "license": "MIT",
  "author": "Shards Inc Ltd",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:init": "turbo run build --filter=@lumina/db... && npm run db:init --workspace=@lumina/db",
    "clean": "turbo run clean",
    "dev:web": "turbo run dev --filter=lumina-web",
    "dev:api": "turbo run dev --filter=lumina-api",
    "dev:worker": "turbo run dev --filter=lumina-worker",
    "dev:all": "turbo run dev"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "turbo": "^2.8.10",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
